# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key-here

# JWT signing secret (required in production — use a long random string)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Server configuration
PORT=3001
NODE_ENV=production

# Database directory (leave empty to use ./data)
DATA_DIR=./data

# Coach accounts.
# If a password is omitted, a strong random one is generated and printed to the
# server logs on first run so it can be rotated. Never commit real passwords.
ERIKA_EMAIL=
ERIKA_PASSWORD=
DANI_EMAIL=
DANI_PASSWORD=
